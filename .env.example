# Sao chép file này thành ".env" và điền các giá trị của bạn.

# ---- Bộ lọc nội dung (kiểm duyệt LLM) ----
# Bộ lọc được điều khiển trực tiếp từ trang host (máy chiếu), và cài đặt của
# trang host được lưu trong data/settings.json — các giá trị ở đây chỉ khởi tạo
# cho lần chạy đầu tiên. Khi BẬT nhưng chưa có key LLM, bộ lọc chấp thuận mọi thứ.
ENABLE_MODERATION=false

# Nhà cung cấp LLM — bất kỳ API chat tương thích OpenAI nào. Mặc định là
# OpenRouter với DeepSeek V4 Flash (nhanh + gần như miễn phí ở tải này). Đổi nhà
# cung cấp bằng cách thay ba giá trị dưới đây; không cần sửa code.
#   OpenRouter: https://openrouter.ai/api/v1  (key: https://openrouter.ai/keys)
#               models: deepseek/deepseek-v4-flash, z-ai/glm-5.2, minimax/minimax-m3, ...
#   Kimi:       https://api.moonshot.ai/v1    (key: https://platform.moonshot.ai)
#   DeepSeek:   https://api.deepseek.com/v1
#   GLM:        https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Kiểm tra key và liệt kê model bằng:  bun run check-llm

# Cho phép bộ lọc tìm kiếm web cho từng bài hát (CHỈ OpenRouter — dùng web plugin
# của OpenRouter). Model sẽ thấy kết quả trực tiếp — thường là lời bài hát thực —
# để tiêu đề trong sáng không che giấu nội dung rõ ràng. Tăng khoảng ~$0.005 cho
# mỗi request kiểm duyệt (tìm kiếm Exa) và thêm vài giây độ trễ. Để false với nhà
# cung cấp khác; họ sẽ từ chối field bổ sung.
LLM_WEB_SEARCH=false

# "strict" = chỉ nội dung an toàn cho gia đình. Giá trị khác = chỉ lọc nội dung
# rõ ràng/không phải âm nhạc.
# Có thể đổi trực tiếp từ trang host (nút bộ lọc chuyển qua off/on/strict).
MODERATION_MODE=default

# Đây là sự kiện gì — gửi cho LLM kiểm duyệt để đánh giá mức phù hợp với dịp này
# (ví dụ từ chối quốc ca/bài hát chính trị tại sự kiện trường học).
# Có thể sửa trực tiếp từ trang host (nút bối cảnh); đây chỉ là giá trị khởi tạo.
# Mặc định: "một buổi tiệc tối mừng lễ tốt nghiệp trung học (giống dạ tiệc) ở Hồng Kông"
EVENT_CONTEXT=

# Mật khẩu cho trang host (máy chiếu) và các điều khiển. Rất khuyến nghị đặt khi
# ứng dụng dùng domain công khai — nếu không, bất kỳ ai biết URL đều có thể
# bỏ qua/xóa bài hát. Khách không cần mật khẩu này. Bỏ trống = không đăng nhập
# (mạng LAN đáng tin cậy).
HOST_PASSWORD=

# ---- Tài khoản quản trị & điểm thưởng ----
# /admin dùng tài khoản admin riêng, không dùng mật khẩu Host. Admin đầu tiên
# chỉ được tạo khi cả hai biến dưới đây có giá trị ở lần khởi động đầu tiên.
# Hãy dùng mật khẩu mạnh và không commit file .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ngày điểm danh được tính hoàn toàn ở server theo múi giờ này.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Port ứng dụng lắng nghe (bên trong container; reverse proxy trỏ tới port này).
PORT=45416

# ---- Địa chỉ công khai (nơi mã QR trỏ tới) ----
# Khi chạy sau reverse proxy với domain, đặt URL công khai đầy đủ. Khách quét mã
# QR trỏ tới đây, và URL phải truy cập được từ điện thoại/mạng di động của họ.
PUBLIC_URL=

# Chỉ dùng dự phòng khi PUBLIC_URL trống (truy cập LAN trực tiếp, không proxy):
# IP LAN của server để tạo mã QR. Tìm bằng:  hostname -I
HOST_IP=
