# Copy this file to ".env" and fill in your values.

# ---- Content filter (LLM moderation) ----
# The filter is controlled from the host projector page, and host settings are
# stored in data/settings.json. Values here are used only for first-run defaults.
# When enabled without an LLM key, the filter approves every request.
ENABLE_MODERATION=false

# LLM provider — any OpenAI-compatible chat API. The default is OpenRouter with
# DeepSeek V4 Flash (fast and nearly free at this workload). Change providers by
# changing the three values below; no code changes are required.
#   OpenRouter: https://openrouter.ai/api/v1  (key: https://openrouter.ai/keys)
#               models: deepseek/deepseek-v4-flash, z-ai/glm-5.2, minimax/minimax-m3, ...
#   Kimi:       https://api.moonshot.ai/v1    (key: https://platform.moonshot.ai)
#   DeepSeek:   https://api.deepseek.com/v1
#   GLM:        https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# ---- Autonomous chat AI ----
# Separate configuration prevents a chat-model change from changing the song
# filter. If CHAT_AI_API_KEY is empty, chat AI reuses the LLM_* values above.
# Put real keys only in the running machine's .env; never commit them.
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://flowgiare.com/v1
CHAT_AI_MODEL=antigravity/gemini-3.7-flash-high

# Verify the key and list models with:  bun run check-llm

# Allow the filter to search the web for each song (OpenRouter only, using the
# OpenRouter web plugin). The model sees live results, often actual lyrics, so a
# clean title cannot hide explicit content. This adds about $0.005 per moderated
# request (Exa search) and a few seconds of latency. Keep false for other
# providers; they may reject the extra field.
LLM_WEB_SEARCH=false

# "strict" = family-safe content only. Other values use the normal explicit or
# non-music filter. The host page can cycle the filter through off/on/strict.
MODERATION_MODE=default

# Event description sent to the moderation LLM to judge suitability for the
# occasion (for example, rejecting anthems or political songs at a school event).
# It can be edited from the host context button; this is only the initial value.
# Default: "a high-school graduation dinner (prom-like) in Hong Kong"
EVENT_CONTEXT=

# Password for the host projector page and controls. Strongly recommended when
# the app uses a public domain; otherwise anyone who knows the URL can skip or
# remove songs. Guests do not need this password. Empty means no authentication
# on a trusted LAN.
HOST_PASSWORD=

# ---- Admin account and points ----
# /admin uses a separate admin account, not the host password. The first admin is
# created only when both values below are set on the first startup. Use a strong
# password and never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Check-in dates are calculated on the server in this time zone.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Application listening port (inside the container; the reverse proxy targets it).
PORT=45416

# Number of trusted reverse-proxy hops used to determine client IPs for rate
# limits. Leave false for direct/LAN access; set to 1 when exactly one known
# reverse proxy sits in front of the app. Avoid true unless every proxy hop is
# controlled by you.
TRUST_PROXY=false

# Per-IP WebSocket abuse controls. Defaults support the repository's 140-guest
# load test while bounding a runaway client. Lower these for a small private
# event or raise them only when the proxy and venue network are trusted.
WS_MAX_CONNECTIONS_PER_IP=200
WS_MAX_MESSAGES_PER_IP=600
WS_MAX_TRACKED_IPS=5000

# ---- Public address (the QR code target) ----
# When running behind a reverse proxy with a domain, set the complete public URL.
# The guest QR code points here, and phones/mobile networks must be able to reach it.
PUBLIC_URL=

# Fallback used only when PUBLIC_URL is empty (direct LAN access without a proxy).
# LAN IP of the server used to generate the QR code. Find it with: hostname -I
HOST_IP=
